# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# Chave da API da Groq (console.groq.com/keys). Começa com gsk_
GROQ_API_KEY=

# Modelo (opcional)
GROQ_MODEL=openai/gpt-oss-120b

# Senha compartilhada entre o app e o servidor. Use um texto longo e aleatório.
# O mesmo valor vai no app, em EXPO_PUBLIC_PONTE_TOKEN (arquivo .env da raiz).
PONTE_APP_TOKEN=

# Porta (serviços de nuvem costumam definir sozinhos)
PORT=8787

# Limites de perguntas
LIMIT_HOUR=20
LIMIT_DAY=50
LIMIT_GLOBAL_DAY=500

# E-mail de contato mostrado na Política de Privacidade e nos Termos
CONTACT_EMAIL=

# Opcional: receber as opiniões dos testadores por e-mail (resend.com). A chave começa com re_
RESEND_API_KEY=
# Para onde vão as opiniões (padrão: CONTACT_EMAIL). Sem domínio próprio no Resend,
# use o mesmo e-mail da conta do Resend.
FEEDBACK_EMAIL_TO=
# Remetente (padrão: Ponte <onboarding@resend.dev>; troque depois de verificar um domínio)
FEEDBACK_EMAIL_FROM=

# Opcional: webhook (ex.: Discord) para receber as opiniões dos testadores
FEEDBACK_WEBHOOK_URL=
